  "main": "index.js",
  "scripts": {
    "build": "nuxt build",
    "dev": "rm -rf /tmp/nitro && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint ./src",
    "lint:fix": "corepack pnpm lint --fix",
    "typecheck": "nuxt typecheck",
    "test": "nuxt prepare && vitest run --passWithNoTests",
    "clean": "nuxt cleanup"
  },
  "lint-staged": {
    "src/**/*.{js,ts,vue}": "pnpm exec eslint",
    "src/**/*.{ts,vue}": "bash -c 'pnpm typecheck'"
